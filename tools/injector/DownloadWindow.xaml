<Window x:Class="OptiScalerInjector.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从 GitHub Releases 下载发布包" Width="780" Height="440" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="Lst" BorderBrush="{StaticResource Line}" DisplayMemberPath="Label" Padding="4"/>
        <TextBlock x:Name="LblInfo" Grid.Row="1" Text="正在获取 Release 列表…" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        <ProgressBar x:Name="Bar" Grid.Row="2" Height="8" Margin="0,8,0,0" Foreground="{StaticResource Accent}" Maximum="100"/>
        <Button x:Name="BtnGo" Grid.Row="3" Content="下载并使用所选" Style="{StaticResource Primary}" IsEnabled="False"
                HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnGo"/>
    </Grid>
</Window>
