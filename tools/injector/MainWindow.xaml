<Window x:Class="OptiScalerInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiScaler DLSS-NR 注入器" Width="1120" Height="800" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="LblGpu" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock Text="OptiScaler  ·  DLSS Neural Rendering 注入器" FontSize="20" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- 资源 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="发布包" Style="{StaticResource H}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPkg" Grid.Column="1" LostFocus="PkgChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="从 GitHub 下载…" Click="OnDownload" Style="{StaticResource Primary}" Padding="12,5"/>
                    <Button Content="目录…" Click="OnPickPkgDir" Margin="6,0,0,0"/>
                    <Button Content="zip…" Click="OnPickPkgZip" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="LblPkg" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,10" Style="{StaticResource MutedText}"/>

                <TextBlock Grid.Row="2" Text="NR 运行库" Style="{StaticResource H}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtRt" Grid.Row="2" Grid.Column="1" LostFocus="RuntimeChanged"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="下载默认 SF-v2" Click="OnDownloadRuntime" Style="{StaticResource Primary}" Padding="12,5"/>
                    <Button Content="选择 dll / zip…" Click="OnPickRuntime" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="LblRt" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0" Style="{StaticResource MutedText}"/>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- 游戏列表 -->
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="添加文件夹…" Click="OnAddGame" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="刷新" Click="OnRefresh" Margin="6,0,0,0"/>
                        <TextBox DockPanel.Dock="Right" x:Name="TxtSearch" Width="120" TextChanged="SearchChanged"/>
                        <TextBlock Text="① 选择游戏" Style="{StaticResource H}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListView x:Name="LstGames" SelectionMode="Single" SelectionChanged="GameSelected" BorderBrush="{StaticResource Line}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="游戏" Width="230" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="平台" Width="64" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- 设置 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="② 目标目录(游戏真正的 exe 所在目录)" Style="{StaticResource H}"/>
                        <DockPanel Margin="0,6,0,2">
                            <Button DockPanel.Dock="Right" Content="浏览…" Click="OnPickTarget" Margin="6,0,0,0"/>
                            <ComboBox x:Name="CbTarget" IsEditable="True" SelectionChanged="TargetChanged" LostFocus="TargetChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="LblTarget" Text="先在左侧选择游戏" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>

                        <TextBlock Text="③ 注入选项" Style="{StaticResource H}" Margin="0,0,0,6"/>
                        <GroupBox Header="代理 DLL 与上游路径" Padding="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="代理文件名" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CbProxy" Width="140" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,6"
                                           Text="默认 dxgi.dll;Vulkan 用 winmm.dll;CP2077 的 RR 选项变灰请避开 d3d12.dll"/>
                                <CheckBox x:Name="ChkDx12" Content="DX12 游戏强制 Dx12Upscaler=dlss(如 BG3 的 bg3.exe)"/>
                                <CheckBox x:Name="ChkDx11" Content="DX11 游戏用 Dx11Upscaler=dlss_12(DX11on12,唯一可跑 NR 的 DX11 路径)"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Neural Rendering  [DlssNr]" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="ChkNr" Content="Enabled(启用 NR;发布包内默认关闭)" IsChecked="True"/>
                                <CheckBox x:Name="ChkPre" Content="RunBeforeSR(在超分之前运行)" IsChecked="True"/>
                                <CheckBox x:Name="ChkFin" Content="FinishedPicture(作用于最终画面,实验性,仅原生 DX12)"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Passes" Width="100" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CbPasses" Width="64" SelectedIndex="0">
                                        <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="WorkingScale" Width="100" VerticalAlignment="Center"/>
                                    <Slider x:Name="SldScale" Minimum="0.25" Maximum="1" Value="1" Width="220" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" ValueChanged="ScaleChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblScale" Text="1.00" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,4"
                                           Text="RTX 20/30 走更重的 FP16 路径,建议 Passes=1,必要时降低 WorkingScale。"/>
                                <CheckBox x:Name="ChkLog" Content="写入 OptiScaler.log(LogLevel=2,便于排查菜单不出现)" IsChecked="True"/>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnInstall" Content="注  入" Style="{StaticResource Primary}" Click="OnInstall"/>
                            <Button x:Name="BtnUninstall" Content="卸载并还原" Style="{StaticResource DangerBtn}" Click="OnUninstall" Margin="8,0,0,0"/>
                            <Button Content="打开目录" Click="OnOpenDir" Margin="8,0,0,0"/>
                            <Button Content="打开 OptiScaler.ini" Click="OnOpenIni" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Text="游戏内按 Insert 打开 OptiScaler 菜单(部分键盘布局为 Alt+Insert)。请勿用于带反作弊的多人游戏。"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="3" Background="#14161B" CornerRadius="8" Padding="2">
            <Grid>
                <RichTextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" VerticalScrollBarVisibility="Auto" Padding="8"/>
                <ProgressBar x:Name="Pb" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
